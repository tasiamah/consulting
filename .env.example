# ─────────────────────────────────────────────────────────────────────────────
# Contact form delivery
# ─────────────────────────────────────────────────────────────────────────────
# Without RESEND_API_KEY the contact form returns a clear error telling the
# visitor to email directly, rather than silently discarding the enquiry.
#
# Setup:
#   1. Create a free account at https://resend.com
#   2. Add and verify aandhconsultinggroup.com as a sending domain
#   3. Create an API key and set the values below in Vercel → Settings →
#      Environment Variables (Production, Preview, and Development)

RESEND_API_KEY=

# Inbox that receives website enquiries.
CONTACT_INBOX=info@aandhconsultinggroup.com

# Verified sender. Must be on a domain verified in Resend.
CONTACT_FROM=Website Enquiry <website@aandhconsultinggroup.com>
